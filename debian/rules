#!/usr/bin/make -f

%:
	dh $@

# Vendored, so the *build* touches no network. `--frozen` makes that a
# guarantee rather than an intention.
#
# **Vendoring itself is not offline, and cannot be here.** Four of this
# node's dependencies live in FlowRateHQ's private GitLab, so `cargo
# vendor` needs credentials or a warm cache — it is the developer's
# `CARGO_HOME`, deliberately, rather than a clean one that cannot reach
# them. The build is therefore reproducible on a machine that can already
# build this repo, and not on a bare host.
#
# That is a real limitation and the honest place for it is here rather
# than in a comment claiming hermeticity it does not have. A build host
# with its own GitLab deploy key is the fix, and it is CI work.
override_dh_auto_configure:
	mkdir -p .cargo
	cargo vendor vendor > .cargo/config.toml

override_dh_auto_build:
	cargo build --frozen --release --bin dln-node

override_dh_auto_install:
	install -D -m 0755 target/release/dln-node \
		debian/dln-node/usr/bin/dln-node
	install -D -m 0644 config.example.toml \
		debian/dln-node/usr/share/doc/dln-node/config.example.toml

# The tests that matter need a relay, a chain and a node. A build host has
# none of the three; they run in dln-node-e2e-test.
override_dh_auto_test:

# Installed disabled. It cannot start without an identity, and creating
# one is an operator's act — see the package description.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_auto_clean:
	rm -rf vendor .cargo
	cargo clean || true
